# ======================
# Aqlli Ustoz - Environment
# ======================

# Telegram Bot Token (BotFather dan oling)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ===== AI Provider tanlash =====
# Mumkin qiymatlar: groq | gemini
# Tavsiya: avval groq (tez), keyin gemini (sifatliroq)
AI_PROVIDER=groq

# --- Groq (bepul + juda tez) ---
# https://console.groq.com dan oling
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
# Boshqa variantlar: openai/gpt-oss-120b , openai/gpt-oss-20b

# --- Google Gemini (bepul + yuqori sifat) ---
# https://aistudio.google.com/app/apikey dan oling
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Yoki: gemini-3.8-flash , gemini-2.5-pro

# --- Ixtiyoriy ---
# ADMIN_IDS=123456789,987654321
