# Cloudflare Worker secrets (set these in Cloudflare Dashboard, not in Git)
TELEGRAM_BOT_TOKEN=add_from_BotFather
TELEGRAM_WEBHOOK_SECRET=use_a_random_32_character_secret

# Workers AI is bound as AI in wrangler.toml; no separate model API key is required.
SETUP_KEY=one_time_setup_key_from_cloudflare_secret
